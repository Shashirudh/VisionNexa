# Server Configuration (Render automatically injects PORT)
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model Configuration
MODEL_WEIGHTS_FILE=drishtiAI_efficientnet_b0.pth
# Optional: Direct download link for production weights if not checked into Git
# MODEL_WEIGHTS_URL=https://your-storage-host.com/drishtiAI_efficientnet_b0.pth
# Optional: Explicit custom path to weights (e.g. Render persistent disk)
# MODEL_WEIGHTS_PATH=/var/data/weights/drishtiAI_efficientnet_b0.pth
DEVICE=cpu

